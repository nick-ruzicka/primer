# Primer — environment variables
# Copy to .env and fill in secrets. Never commit .env.

# ---------- Secrets (required) ----------

# Anthropic API key — powers brief generation + validation agent.
# Get one at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Exa API key — optional external web signals. V1 falls back to seeded signals.
# Leave blank to skip Exa entirely.
EXA_API_KEY=

# ---------- Runtime ----------

# Redis connection string. Default assumes Redis on the same host.
REDIS_URL=redis://localhost:6379

# Path to the seeded SQLite DB.
# Local dev: ./data/primer.db
# Server (systemd unit): /opt/primer/app/data/primer.db
DATABASE_PATH=./data/primer.db

# CORS. Comma-separated list, no spaces. In prod, set to https://<your-domain>.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- Models (optional overrides) ----------
BRIEFING_MODEL=claude-opus-4-7
VALIDATION_MODEL=claude-haiku-4-5-20251001

# ---------- Cache + rate limit ----------
BRIEF_CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_HOUR=20

# ---------- Demo anchor ----------
# Relative phrasing in briefs ("3 days ago") resolves against this date.
ANCHOR_DATE=2026-04-22

# Exa — V1 reads from seeded signals; set 1 to try the live API.
USE_LIVE_EXA=0

# ---------- Frontend (Next.js) ----------
# Public envs are prefixed NEXT_PUBLIC_ and are baked into the client bundle.

# Backend base URL the browser uses to hit /api and /briefing.
# Local dev: http://localhost:8000
# Prod (same origin via nginx): leave blank so relative URLs are used.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---------- Deploy (scripts/deploy.sh) ----------
# Read by the deploy script, not by the app itself.

# SSH target for the Hetzner box.
# PRIMER_SERVER=root@5.161.116.216

# Branch to deploy. Default: main.
# BRANCH=main

# Public domain. Used by setup_server.sh, nginx config, and certbot.
# PRIMER_DOMAIN=primer.REPLACE_ME.com
